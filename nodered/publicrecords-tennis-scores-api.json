[
  {
    "id": "1",
    "type": "tab",
    "label": "Public Records Tennis Scores",
    "disabled": false,
    "info": "Runs publicrecords/tennis-scores-api on YOUR Apify account. Set APIFY_TOKEN. Standby/MCP is not built. Disclosure: Public Records maintains the Actor."
  },
  {
    "id": "2",
    "type": "inject",
    "z": "1",
    "name": "every morning",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "",
    "crontab": "00 07 * * *",
    "once": false,
    "x": 120,
    "y": 80,
    "wires": [
      [
        "3"
      ]
    ]
  },
  {
    "id": "3",
    "type": "http request",
    "z": "1",
    "name": "Apify tennis-scores-api",
    "method": "POST",
    "ret": "obj",
    "url": "https://api.apify.com/v2/acts/publicrecords~tennis-scores-api/run-sync-get-dataset-items?token=${APIFY_TOKEN}",
    "headers": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "payload": "{\"tournament\": \"wimbledon\", \"date\": \"2026-07-12\", \"maxResults\": 20}",
    "x": 360,
    "y": 80,
    "wires": [
      [
        "4"
      ]
    ]
  },
  {
    "id": "4",
    "type": "debug",
    "z": "1",
    "name": "tennis rows",
    "x": 560,
    "y": 80,
    "wires": []
  }
]
